# Accounts created before bcrypt was added must be removed from the test database
# and registered again. Do not delete production accounts.
### Регистрация: пароль будет сохранён в виде хеша
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "frontend_test@dot.com",
  "password": "testPassword123",
  "first_name": "Алексей",
  "last_name": "Тестовый"
}

### Вход: скопируйте token из ответа и укажите в @token выше
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "frontend_test@dot.com",
  "password": "testPassword123"
}

### Получить свой профиль
GET {{baseUrl}}/users/me
Authorization: Bearer {{token}}

### Обновить профиль (имя и аватар)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "first_name": "Алексей",
  "last_name": "Тестовый",
  "avatar_url": "https://example.com/avatar.jpg"
}

### Изменить email — обязательно подтвердить текущим паролем
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "new_email@dot.com",
  "current_password": "testPassword123"
}

### Изменить пароль
PATCH {{baseUrl}}/users/me/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "current_password": "testPassword123",
  "new_password": "newPassword123"
}

### Получить мечты текущего пользователя
GET {{baseUrl}}/dreams
Authorization: Bearer {{token}}

### Создать мечту
POST {{baseUrl}}/dreams
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Поездка в Киото весной",
  "description": "Увидеть цветение сакуры",
  "target_date": "2027-04-15",
  "image_url": "https://example.com/kyoto.jpg"
}

### Получить одну мечту (подставьте UUID из ответа)
GET {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509
Authorization: Bearer {{token}}

### Частично обновить мечту
PUT {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "progress": 25
}

### Удалить мечту
DELETE {{baseUrl}}/dreams/00000000-0000-4000-8000-000000000001
Authorization: Bearer {{token}}

### Получить привычки текущего пользователя
GET {{baseUrl}}/habits
Authorization: Bearer {{token}}

### Создать привычку
POST {{baseUrl}}/habits
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Ежедневно заниматься языком",
  "description": "Практика 20 минут",
  "frequency": "daily",
  "dream_id": null
}

### Получить одну привычку (подставьте UUID из ответа)
GET {{baseUrl}}/habits/2c4f59b8-8578-4da6-9350-336f053ea567
Authorization: Bearer {{token}}

### Обновить привычку
PUT {{baseUrl}}/habits/2c4f59b8-8578-4da6-9350-336f053ea567
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "frequency": "weekly",
  "is_active": true
}

### Удалить привычку
DELETE {{baseUrl}}/habits/2c4f59b8-8578-4da6-9350-336f053ea567
Authorization: Bearer {{token}}

### Создать этап плана для принадлежащей вам мечты
POST {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Исследование и планирование",
  "stage_order": 1
}

### Этап 2: Финансовая подготовка
POST {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Финансовая подготовка",
  "stage_order": 2
}


### Этап 3: Бронирование и документы
POST {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Бронирование и документы",
  "stage_order": 3
}


### Этап 4: Финальные приготовления
POST {{baseUrl}}/dreams/a27b9488-5ca9-45d2-b594-a992a38c6509/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Финальные приготовления",
  "stage_order": 4
}

