@baseUrl = http://localhost:3001/api

### =========================================================
### 1. ПОЛЬЗОВАТЕЛИ (Users)
### =========================================================

### Создать тестового пользователя
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "frontend_test@dot.com",
  "password": "testPassword123",
  "first_name": "Алексей",
  "last_name": "Тестовый",
  "avatar_url": "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&h=100"
}
# 👉 ВАЖНО: Скопируй "id" из ответа ниже, он понадобится для создания мечты.


### Получить список всех пользователей
GET {{baseUrl}}/users


### =========================================================
### 2. МЕЧТЫ (Dreams)
### =========================================================

### Создать новую мечту с обложкой
# ⚠️ ЗАМЕНИ user_id НА РЕАЛЬНЫЙ ID ИЗ ПРЕДЫДУЩЕГО ОТВЕТА
POST {{baseUrl}}/dreams
Content-Type: application/json

{
  "title": "Поездка в Киото весной",
  "description": "Увидеть цветение сакуры и попробовать настоящий рамен",
  "target_date": "2027-04-15",
  "image_url": "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=800&q=80"
}
# 👉 ВАЖНО: Скопируй "id" этой мечты, он понадобится для этапов.


### Получить список всех мечт (для дашборда)
GET {{baseUrl}}/dreams


### Получить детальную информацию о мечте (с пустым планом)
# ⚠️ ЗАМЕНИ НА ID СОЗДАННОЙ МЕЧТЫ
GET {{baseUrl}}/dreams/

### =========================================================
### 7. ПОЛНОЦЕННЫЙ ПЛАН: НЕСКОЛЬКО ЭТАПОВ С ЗАДАЧАМИ
### =========================================================

### Этап 1: Исследование и планирование
POST {{baseUrl}}/dreams/66f21630-7977-407e-854e-85b19f9f9818/stages
Content-Type: application/json

{
  "title": "Исследование и планирование",
  "stage_order": 1
}


### Этап 2: Финансовая подготовка
POST {{baseUrl}}/dreams/66f21630-7977-407e-854e-85b19f9f9818/stages
Content-Type: application/json

{
  "title": "Финансовая подготовка",
  "stage_order": 2
}


### Этап 3: Бронирование и документы
POST {{baseUrl}}/dreams/66f21630-7977-407e-854e-85b19f9f9818/stages
Content-Type: application/json

{
  "title": "Бронирование и документы",
  "stage_order": 3
}


### Этап 4: Финальные приготовления
POST {{baseUrl}}/dreams/66f21630-7977-407e-854e-85b19f9f9818/stages
Content-Type: application/json

{
  "title": "Финальные приготовления",
  "stage_order": 4
}


