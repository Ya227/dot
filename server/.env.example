PORT=3001
NODE_ENV=development

# Строка подключения к базе данных (Supabase)
# Формат: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres
# ВАЖНО: пароль должен содержать только буквы и цифры, либо спецсимволы должны быть URL-кодированы.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres